# Пример файла настроек. Скопируй в .env и заполни значения.
# Сам .env в git не попадает — в нём секреты.

# Секретный ключ Django. Сгенерировать:
# uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Режим отладки: True только на своём компьютере, на сервере — False
DEBUG=

# Разрешённые адреса сайта через запятую, без пробелов: localhost,127.0.0.1
ALLOWED_HOSTS=

# Только для сервера, через запятую: https://example.ru
CSRF_TRUSTED_ORIGINS=

# Адрес админки латиницей, со слешем в конце, например: panel/
ADMIN_URL=

# Только для сервера (PostgreSQL): postgres://user:password@host:5432/dbname
# На своём компьютере не нужно — там используется SQLite
DATABASE_URL=
