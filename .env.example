# Пример файла настроек. Скопируй в .env и заполни значения.
# Сам .env в git не попадает — в нём секреты.

# Секретный ключ Django. Сгенерировать:
# uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Режим отладки: True только на своём компьютере, на сервере — False
DEBUG=

# Разрешённые адреса сайта через запятую, без пробелов:
# локально — localhost,127.0.0.1; на PythonAnywhere — alexks09.pythonanywhere.com
ALLOWED_HOSTS=

# Только для сервера, через запятую: https://alexks09.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=

# Адрес админки латиницей, со слешем в конце, например: panel/
ADMIN_URL=

# Необязательно: по умолчанию в dev и prod используется локальный SQLite (db.sqlite3).
# Для PostgreSQL/MySQL задайте строку подключения, например: postgres://user:password@host:5432/dbname
# DATABASE_URL=

# Доверять заголовкам обратного прокси (X-Real-IP / X-Forwarded-For).
# В prod.py по умолчанию True (нужно для PythonAnywhere), локально — False.
# TRUST_PROXY_HEADERS=True

# HSTS в секундах (в prod.py по умолчанию 3600).
# SECURE_HSTS_SECONDS=3600
